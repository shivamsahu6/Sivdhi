# Copy this file to .env and fill in your own private values.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=sivdhi.db
EMAIL=your-sender@example.com
EMAIL_APP_PASSWORD=replace-with-provider-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TIMEOUT=20
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Assignment matching: 60-minute total deadline, split evenly across eligible workers.
# Example: 6 eligible workers = 600 seconds per worker; 12 = 300 seconds each.
SIVDHI_ASSIGNMENT_DEADLINE_MINUTES=60
# Poll often enough to detect short per-worker response windows.
SIVDHI_ASSIGNMENT_MONITOR_INTERVAL_SECONDS=2
