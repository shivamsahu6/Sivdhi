# Copy this file to .env and fill in your own private values.
APP_ENV=development
# REQUIRED in production: generate a private random path (32-96 chars).
# Do not publish the real value in GitHub, screenshots, or public documentation.
ADMIN_PANEL_PATH=replace-this-with-a-private-random-32-plus-character-path
# Keep the one-time Admin bootstrap disabled after creating the first Admin.
ADMIN_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Generate with: py -3.14 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key backed up and private; losing it makes stored Admin MFA secrets unreadable.
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DATABASE_PATH=sivdhi.db
EMAIL=your-sender@example.com
EMAIL_APP_PASSWORD=replace-with-provider-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TIMEOUT=20
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Assignment matching: send the nearest five workers together, then another
# five every 15 seconds. Earlier requests remain active until accepted or the
# global deadline expires.
SIVDHI_ASSIGNMENT_DEADLINE_MINUTES=60
SIVDHI_ASSIGNMENT_BATCH_SIZE=5
SIVDHI_ASSIGNMENT_BATCH_INTERVAL_SECONDS=15
# Poll often enough to open the next matching batch close to its schedule.
SIVDHI_ASSIGNMENT_MONITOR_INTERVAL_SECONDS=2

# Cashfree Payment Gateway. Keep credentials only in the server .env.
# Use SIVDHI_PAYMENT_MODE=cashfree and CASHFREE_ENV=sandbox for testing.
# Switch CASHFREE_ENV to production only after Cashfree production approval.
SIVDHI_PAYMENT_MODE=demo
SIVDHI_PUBLIC_BASE_URL=https://sivdhi.duckdns.org
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

